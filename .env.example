# ---- API ----
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://rmd:rmd@localhost:5433/rmd
REDIS_URL=redis://localhost:6380/0
# auto = use the RQ worker if one is listening, else run ingestion inside the API process
INGEST_MODE=auto
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# LLM / embeddings provider: openai | mock
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
GENERATION_MODEL=gpt-4.1-mini
VERIFICATION_MODEL=gpt-4.1-mini

# Rate limiting
RATE_LIMIT_ASK=20/minute

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# End-user accounts (Supabase Auth). Leave empty to run guest-only.
# API verifies tokens against SUPABASE_URL's JWKS (or SUPABASE_JWT_SECRET for legacy HS256 projects).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Question limits (slowapi syntax)
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_ASK_GUEST_DAILY=40/day
RATE_LIMIT_ASK_USER_DAILY=300/day
RATE_LIMIT_ASK_GLOBAL_DAILY=3000/day
